    },
    {
      "id": "cargo.doctest",
      "scope": "cargo",
      "input_authority": ["library target inputs", "Rust documentation examples", "Cargo manifests"],
      "consumers": ["just test-all", "compatibility/msrv"]
    },
    {
      "id": "cargo.fmt",
      "scope": "repository",
      "input_authority": ["Rust sources", "rustfmt.toml", "rust-toolchain.toml"],
      "consumers": ["scripts/check/check.sh", "scripts/check-compiler-fact-driver.sh"]
    },
    {
      "id": "cargo-command-policy",
      "scope": "repository",
      "input_authority": ["tracked Rust, workflow, script, and documentation command text", "scripts/ci/check-locked-cargo.sh", "scripts/ci/check-locked-cargo-test.sh"],
      "consumers": ["scripts/check/check.sh"]
    },
    {
      "id": "installers",
      "scope": "repository",
      "input_authority": ["install.sh", "install.ps1", "scripts/ci/check-installers.sh"],
      "consumers": ["scripts/check/check.sh", "compatibility/msrv"]
    },
    {
      "id": "dependency-policy",
      "scope": "repository",
      "input_authority": ["Cargo.toml", "Cargo.lock", "deny.toml"],
      "consumers": ["scripts/check/check.sh"]
    },
    {
      "id": "cargo.clippy",
      "scope": "cargo",
      "input_authority": ["Cargo build inputs", "Cargo manifests", "toolchain configuration"],
      "consumers": ["scripts/check/check.sh"]
    },
    {
      "id": "docs.generated",
      "scope": "repository",
      "input_authority": ["Clap definitions", "support manifests", "scripts/docs/generate.sh"],
      "consumers": ["scripts/check/check.sh"]
    },
    {
      "id": "cargo.doc",
      "scope": "cargo",
      "input_authority": ["library target inputs", "Rust documentation", "Cargo manifests"],
      "consumers": ["scripts/check/check.sh"]
    },
    {
      "id": "compiler-fact-driver",
      "scope": "repository",
      "input_authority": ["tools/compiler-fact-driver", "compiler fact protocol and packaging scripts", "rustfmt.toml"],
      "consumers": ["just check-compiler-fact-driver", "commit/quality", "release-archives/build"]
    },
    {
      "id": "release.semver",
      "scope": "cargo",
      "input_authority": ["release.semver_check", "public API compiler evidence", "publishable package graph"],
      "consumers": ["release semantic checking"]
    },
    {
      "id": "compatibility",
      "scope": "variants",
      "input_authority": ["tests/compatibility/manifest.json", "compatibility fixtures and runners", "Cargo build and test inputs"],
      "consumers": ["commit/compatibility", "compatibility/msrv", "compatibility/filesystem"]
    },
    {
      "id": "release-archives",
      "scope": "variants",
      "input_authority": ["distribution/release-targets.json", "release packaging scripts", "release binary and compiler-fact inputs"],
      "consumers": ["commit/release-archives", "release-archives/build"]
    },
    {
      "id": "surface",
      "scope": "repository",
      "input_authority": ["surface configuration", "public Rust API inputs", "compiler evidence"],
      "consumers": ["commit/surface"]
    },
    {
      "id": "action-pins",
      "scope": "repository",
      "input_authority": [".github workflows and actions", ".github/actions-lock.yaml", "scripts/ci/pin-actions.sh"],
      "consumers": ["just verify-actions", "scripts/check/check.sh --affected", "commit/quality"]
    }
  ],
  "quality_operations": [
    {"name": "rustfmt", "work": ["cargo.fmt"]},
    {"name": "locked-cargo-production", "work": ["cargo-command-policy"]},
