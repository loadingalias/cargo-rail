  "source_paths": [
    "justfile",
    "scripts/build/build.sh",
    "scripts/test/test.sh",
    "scripts/check/check.sh",
    "scripts/check-compiler-fact-driver.sh",
    ".github/workflows/commit.yaml",
    ".github/workflows/compatibility.yaml",
    ".github/workflows/release-archives.yaml",
    "tests/compatibility/manifest.json",
    "distribution/release-targets.json"
  ],
  "work": [
    {
      "id": "cargo.build",
      "scope": "cargo",
      "input_authority": ["Cargo metadata", "Cargo source and build inputs", "Rust toolchain and Cargo configuration"],
      "consumers": ["just build", "compatibility/msrv", "release-archives/build"]
    },
    {
      "id": "cargo.test",
      "scope": "cargo",
