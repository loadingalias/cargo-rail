{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loadingalias/cargo-rail/blob/main/schemas/release-record-v9.schema.json",
  "title": "Cargo-Rail release execution record v9",
  "description": "Complete portable release intent and progress. Consumers must also verify canonical intent identity, semantic consistency, checkout and invocation authority. Credentials are never record fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "status",
    "phase",
    "remote_storage",
    "intent",
    "crates",
    "preparation",
    "package_seal",
    "validation",
    "commit_push",
    "readiness",
    "tag_push",
    "abort",
    "artifacts",
    "review",
    "executor",
    "validation_dispatches"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        9
      ]
    },
    "transaction_id": {
      "$ref": "#/$defs/transaction"
    },
    "status": {
      "enum": [
        "active",
        "complete",
        "aborted"
      ]
    },
    "phase": {
      "enum": [
        "planned",
        "prepared",
        "awaiting_review",
        "awaiting_checks",
        "ready",
        "publishing",
        "released"
      ]
    },
    "remote_storage": {
      "type": "boolean"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "crates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progress"
      }
    },
    "preparation": {
      "$ref": "#/$defs/preparation"
    },
    "package_seal": {
      "anyOf": [
        {
          "$ref": "#/$defs/package_seal"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow_run"
      }
    },
    "commit_push": {
      "$ref": "#/$defs/step"
    },
    "readiness": {
      "$ref": "#/$defs/step"
    },
    "tag_push": {
      "$ref": "#/$defs/step"
    },
    "abort": {
      "$ref": "#/$defs/step"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_evidence"
      }
    },
    "review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review"
        }
      ]
    },
    "executor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "validation_dispatches": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    },
    "transaction": {
      "type": "string",
      "pattern": "^release-[A-Za-z0-9-]+$",
      "maxLength": 128
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "complete"
          ]
        },
        "object": {
          "type": "string"
        }
      }
    },
    "preparation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "writing"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "tree"
          ],
          "properties": {
            "status": {
              "enum": [
                "committing"
              ]
            },
            "tree": {
              "$ref": "#/$defs/oid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "commit"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete"
              ]
            },
            "commit": {
              "$ref": "#/$defs/oid"
            }
          }
        }
      ]
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "path"
      ],
      "properties": {
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "restore"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "content": {
          "type": "string"
        },
        "restore": {
          "enum": [
            "before_preparation",
            "always"
          ]
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "publication_attempt",
        "tag",
        "forge_draft",
        "publication",
        "forge_publication",
        "tag_object",
        "alias"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "publication_attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "$ref": "#/$defs/step"
        },
        "forge_draft": {
          "$ref": "#/$defs/step"
        },
        "publication": {
          "$ref": "#/$defs/step"
        },
        "forge_publication": {
          "$ref": "#/$defs/step"
        },
        "tag_object": {
          "anyOf": [
            {
              "$ref": "#/$defs/tag_object"
            },
            {
              "type": "null"
            }
          ]
        },
        "alias": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "package_seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "cargo_version",
        "registry_index",
        "packages"
      ],
      "properties": {
        "source_commit": {
          "$ref": "#/$defs/oid"
        },
        "cargo_version": {
          "type": "string",
          "minLength": 1
        },
        "registry_index": {
          "enum": [
            "https://github.com/rust-lang/crates.io-index"
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "baseline",
        "target",
        "required",
        "detail"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unavailable",
            "not_applicable"
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "changelog_write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_digest",
        "after_digest",
        "content"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "before_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_digest": {
          "$ref": "#/$defs/digest"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "changelog",
        "release_notes",
        "note_inputs"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "changelog": {
          "anyOf": [
            {
              "$ref": "#/$defs/changelog_write"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_notes": {
          "type": "string"
        },
        "note_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "change_presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "format": {
          "enum": [
            "list",
            "markdown"
          ]
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bump",
        "body",
        "presentation"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bump": {
          "enum": [
            "none",
            "patch",
            "minor",
            "major"
          ]
        },
        "body": {
          "type": "string"
        },
        "presentation": {
          "$ref": "#/$defs/change_presentation"
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "subject",
        "body",
        "commit_type",
        "scope",
        "breaking",
        "bump"
      ],
      "properties": {
        "sha": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "breaking": {
          "type": "boolean"
        },
        "bump": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "subject",
        "issue"
      ],
      "properties": {
        "sha": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "issue": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "not_conventional"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "found",
                "suggestion"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "unknown_type"
                  ]
                },
                "found": {
                  "type": "string"
                },
                "suggestion": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "crate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "current_version",
        "new_version",
        "manifest_path",
        "changelog_path",
        "tag_name",
        "previous_tag",
        "changelog_range_start",
        "changelog_range_end",
        "publish",
        "publish_intent",
        "api_evidence",
        "generate_changelog",
        "bump",
        "bump_reason",
        "changelog_body",
        "presentation",
        "commits",
        "commit_diagnostics",
        "dependency_updates",
        "change_entries",
        "affected_dependents"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "current_version": {
          "type": "string"
        },
        "new_version": {
          "type": "string"
        },
        "manifest_path": {
          "$ref": "#/$defs/path"
        },
        "changelog_path": {
          "$ref": "#/$defs/path"
        },
        "tag_name": {
          "type": "string"
        },
        "previous_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changelog_range_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changelog_range_end": {
          "type": "string"
        },
        "publish": {
          "type": "boolean"
        },
        "publish_intent": {
          "type": "string"
        },
        "api_evidence": {
          "$ref": "#/$defs/api"
        },
        "generate_changelog": {
          "type": "boolean"
        },
        "bump": {
          "type": "string"
        },
        "bump_reason": {
          "type": "string"
        },
        "changelog_body": {
          "type": "string"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "commit_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "dependency_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "change_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "version_group": {
          "type": "string"
        },
        "affected_dependents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "workflow_id",
        "run_id",
        "attempt",
        "jobs"
      ],
      "properties": {
        "workflow": {
          "type": "string"
        },
        "workflow_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "id"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "source": {
      "enum": [
        "changes",
        "commits",
        "both"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_contract_version",
        "snapshot_id",
        "source",
        "canonical_crate_order",
        "crates",
        "summary",
        "change_files_to_delete",
        "change_files_to_update",
        "auxiliary_lockfiles",
        "skipped",
        "artifacts"
      ],
      "properties": {
        "plan_contract_version": {
          "enum": [
            9
          ]
        },
        "snapshot_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "canonical_crate_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "crates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crate"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_crates",
            "crates_to_publish",
            "crates_to_tag"
          ],
          "properties": {
            "total_crates": {
              "type": "integer",
              "minimum": 0
            },
            "crates_to_publish": {
              "type": "integer",
              "minimum": 0
            },
            "crates_to_tag": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "change_files_to_delete": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "change_files_to_update": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "auxiliary_lockfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifest_path",
              "lockfile_path",
              "before_digest",
              "after_digest",
              "content"
            ],
            "properties": {
              "manifest_path": {
                "$ref": "#/$defs/path"
              },
              "lockfile_path": {
                "$ref": "#/$defs/path"
              },
              "before_digest": {
                "$ref": "#/$defs/identity"
              },
              "after_digest": {
                "$ref": "#/$defs/identity"
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_requirement"
          }
        }
      }
    },
    "changelog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "relative_to",
        "entry_format",
        "emoji",
        "group_order",
        "fallback",
        "groups",
        "filters",
        "commit_url",
        "pr_url"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "relative_to": {
          "enum": [
            "crate",
            "workspace"
          ]
        },
        "entry_format": {
          "type": "string"
        },
        "emoji": {
          "type": "boolean"
        },
        "group_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "types",
              "title",
              "emoji"
            ],
            "properties": {
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "type": "string"
              },
              "emoji": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skip_types",
            "skip_scopes",
            "include_paths",
            "exclude_paths"
          ],
          "properties": {
            "skip_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skip_scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "include_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "commit_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pr_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
