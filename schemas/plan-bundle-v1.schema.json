{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/loadingalias/cargo-rail/main/schemas/plan-bundle-v1.schema.json",
  "title": "cargo-rail portable plan bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_bundle_version",
    "name",
    "contract",
    "producer",
    "plan_identity",
    "platform_limits",
    "files"
  ],
  "properties": {
    "plan_bundle_version": { "const": 1 },
    "name": { "const": "cargo-rail-plan-bundle" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "cargo-rail-plan" },
        "version": { "const": 8 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "cargo-rail" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "plan_identity": {
      "type": "string",
      "pattern": "^plan-v8:sha256:[0-9a-f]{64}$"
    },
    "platform_limits": {
      "const": {
        "architectures": ["any"],
        "operating_systems": ["linux", "macos", "windows"],
        "requires": ["git", "python>=3.10"],
        "source_authority": "clean_git_object"
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "size", "sha256"],
        "properties": {
          "path": { "enum": ["plan-v8.json", "plan-read.py"] },
          "role": { "enum": ["execution_plan", "portable_plan_reader"] },
          "size": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "oneOf": [
          {
            "properties": {
              "path": { "const": "plan-v8.json" },
              "role": { "const": "execution_plan" }
            }
          },
          {
            "properties": {
              "path": { "const": "plan-read.py" },
              "role": { "const": "portable_plan_reader" },
              "size": { "maximum": 1048576 }
            }
          }
        ]
      },
      "allOf": [
        { "contains": { "properties": { "role": { "const": "execution_plan" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "portable_plan_reader" } }, "required": ["role"] } }
      ]
    }
  }
}
